---
import Banner from './Banner.astro';
import { ago, element, elements, questLog } from '../lib/view.mjs';
---

<section class="chapter" id="log" aria-labelledby="log-title">
  <div class="wrap">
    <Banner
      kicker="Chapter III"
      title="Quest Log"
      subtitle="Every public repo, newest first. A new repo appears here within the hour."
      id="log-title"
    />

    <div class="win log reveal">
      <span class="win-title">Filter by element</span>
      <div class="filters" role="group" aria-label="Filter by language">
        <button type="button" class="filter pixel" aria-pressed="true" data-filter="all">
          All <span>{questLog.length}</span>
        </button>
        {
          elements.map((lang) => (
            <button type="button" class="filter pixel" aria-pressed="false" data-filter={lang}>
              {lang} <span>{questLog.filter((q) => q.language === lang).length}</span>
            </button>
          ))
        }
      </div>

      <ul class="rows" data-rows>
        {
          questLog.map((q) => (
            <li class="row" data-lang={q.language ?? 'none'}>
              <div class="row-main">
                <a class="row-name cursorable pixel" href={q.url} target="_blank" rel="noopener">
                  {q.name}
                </a>
                {q.isNew && <span class="tag-new">NEW</span>}
                {q.featured && (
                  <span class="star" title="Featured in Main or Side Quests">
                    ★
                  </span>
                )}
                {q.homepage && (
                  <a class="row-live pixel" href={q.homepage} target="_blank" rel="noopener">
                    live ↗
                  </a>
                )}
                {q.blurb && <p class="row-blurb">{q.blurb}</p>}
              </div>
              <div class="row-meta pixel">
                {q.language ? (
                  <span class="row-lang" title={`${element(q.language)} element`}>
                    <span class="dot" style={`--c:${q.color}`} aria-hidden="true" />
                    {q.language}
                    {q.notebook && <small>(notebooks)</small>}
                  </span>
                ) : (
                  <span class="row-lang">—</span>
                )}
                <span class="row-commits">{q.commits} commits</span>
                <span class="row-age" data-ago={q.pushedAt}>
                  {ago(q.pushedAt)}
                </span>
              </div>
            </li>
          ))
        }
      </ul>
      <div class="log-foot">
        <p class="pixel" aria-live="polite" data-log-count></p>
        <button type="button" class="btn" data-log-more hidden>▼ Show all quests</button>
      </div>
    </div>
  </div>
</section>

<style>
  .log {
    padding-top: 1.6rem;
  }

  .filters {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    padding-bottom: 1.1rem;
    border-bottom: 2px solid rgba(239, 230, 207, 0.12);
  }

  .filter {
    padding: 0.35em 0.75em;
    font-size: 0.85rem;
    color: var(--ink-dim);
    background: rgba(3, 2, 13, 0.4);
    border: 1px solid rgba(195, 189, 224, 0.25);
    border-radius: 3px;
    cursor: pointer;
  }

  .filter span {
    color: var(--ink-faint);
    margin-left: 0.2em;
  }

  .filter:hover {
    border-color: var(--ink-faint);
    color: var(--ink);
  }

  .filter[aria-pressed='true'] {
    color: var(--frame-dark);
    background: var(--gold);
    border-color: var(--gold);
  }

  .filter[aria-pressed='true'] span {
    color: rgba(3, 2, 13, 0.6);
  }

  .rows {
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .row {
    display: grid;
    grid-template-columns: minmax(0, 1fr) auto;
    gap: 0.4rem 1.5rem;
    align-items: start;
    padding: 0.95rem 0.25rem 0.95rem 1.6rem;
    border-bottom: 1px dashed rgba(239, 230, 207, 0.1);
  }

  .row[hidden] {
    display: none;
  }

  .row:hover {
    background: linear-gradient(90deg, rgba(255, 207, 90, 0.06), transparent 70%);
  }

  .row-main {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.35rem 0.6rem;
    min-width: 0;
  }

  .row-name {
    font-size: 1.05rem;
    text-decoration: none;
    overflow-wrap: anywhere;
  }

  .row-name:hover {
    color: var(--gold);
  }

  .star {
    color: var(--gold);
    font-size: 0.9rem;
  }

  .row-live {
    font-size: 0.78rem;
    color: var(--mana);
    text-decoration: none;
  }

  .row-live:hover {
    text-decoration: underline;
  }

  .row-blurb {
    flex-basis: 100%;
    font-size: 0.9rem;
    color: var(--ink-dim);
    max-width: 75ch;
  }

  .row-meta {
    display: grid;
    grid-template-columns: 9.5rem 6.5rem 5.5rem;
    gap: 0.75rem;
    font-size: 0.8rem;
    color: var(--ink-faint);
    padding-top: 0.25rem;
  }

  .row-lang {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    color: var(--ink-dim);
  }

  .row-lang small {
    font-size: 0.7rem;
    color: var(--ink-faint);
  }

  .row-age {
    text-align: right;
  }

  .log-foot {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: center;
    gap: 0.75rem;
    padding-top: 0.9rem;
    font-size: 0.8rem;
    color: var(--ink-faint);
  }

  .log-foot .btn[hidden] {
    display: none;
  }

  @media (max-width: 760px) {
    .row {
      grid-template-columns: 1fr;
    }
    .row-meta {
      display: flex;
      flex-wrap: wrap;
      gap: 0.4rem 1rem;
    }
  }
</style>

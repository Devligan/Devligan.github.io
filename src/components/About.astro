---
import SectionHead from './SectionHead.astro';
import { config, profile, stats } from '../lib/view.mjs';

const figures = [
  { value: stats.commits.toLocaleString('en-US'), label: 'Commits', note: 'lifetime, public repos' },
  stats.contributions !== null && { value: stats.contributions.toLocaleString('en-US'), label: 'Contributions', note: 'last 12 months' },
  { value: stats.repos, label: 'Public repos', note: 'all listed below' },
  stats.streak !== null && { value: `${stats.streak}d`, label: 'Current streak', note: `longest ${stats.longest} days` },
  stats.practice !== null && { value: stats.practice, label: config.practice.label, note: 'solved', href: stats.practiceUrl },
  { value: stats.since, label: 'On GitHub since', note: `@${profile.handle}` },
].filter(Boolean) as { value: string | number; label: string; note: string; href?: string }[];
---

<section class="section" id="about" aria-labelledby="about-title">
  <div class="wrap">
    <SectionHead index="02 — Profile" title="About" note="Numbers on this page update hourly from GitHub." id="about-title" />

    <div class="about">
      <div class="bio reveal">
        {profile.bio.map((p: string, i: number) => <p class={i === 0 ? 'lead' : ''}>{p}</p>)}
      </div>

      <div class="side">
        <dl class="figures reveal">
          {
            figures.map((f) => (
              <div class="figure">
                <dt>
                  {f.label}
                  <small>{f.note}</small>
                </dt>
                <dd class="mono">
                  {f.href ? (
                    <a href={f.href} target="_blank" rel="noopener">
                      {f.value}
                    </a>
                  ) : (
                    f.value
                  )}
                </dd>
              </div>
            ))
          }
        </dl>

        <div class="skills reveal">
          {
            Object.entries(config.skills).map(([group, items]) => (
              <div class="skill-row">
                <p class="label">{group}</p>
                <ul class="tags">
                  {(items as string[]).map((s) => (
                    <li class="tag">{s}</li>
                  ))}
                </ul>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .about {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.1fr);
    gap: clamp(32px, 6vw, 88px);
    align-items: start;
  }

  .bio {
    display: grid;
    gap: 1.2rem;
    color: var(--dim);
    font-size: 1.05rem;
    line-height: 1.7;
  }

  .bio .lead {
    font: 400 clamp(1.6rem, 2.6vw, 2rem) / 1.3 var(--serif);
    color: var(--text);
  }

  .figures {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    margin: 0;
    border-top: 1px solid var(--line);
    border-left: 1px solid var(--line);
  }

  .figure {
    display: flex;
    flex-direction: column-reverse;
    justify-content: flex-end;
    gap: 0.35rem;
    padding: 1rem 1.1rem 1.1rem;
    border-right: 1px solid var(--line);
    border-bottom: 1px solid var(--line);
  }

  .figure dt {
    display: grid;
    font-size: 0.84rem;
    color: var(--dim);
  }

  .figure dt small {
    font-size: 0.75rem;
    color: var(--faint);
  }

  .figure dd {
    margin: 0;
    font-size: 1.8rem;
    line-height: 1.1;
    letter-spacing: -0.02em;
  }

  .figure dd a {
    text-decoration: underline;
    text-decoration-color: var(--line-2);
    text-underline-offset: 5px;
  }

  .figure dd a:hover {
    text-decoration-color: var(--accent);
  }

  .skills {
    display: grid;
    gap: 1.1rem;
    margin-top: 2rem;
  }

  .skill-row {
    display: grid;
    grid-template-columns: 8.5rem minmax(0, 1fr);
    align-items: baseline;
    gap: 1rem;
  }

  @media (max-width: 900px) {
    .about {
      grid-template-columns: minmax(0, 1fr);
    }
  }

  @media (max-width: 520px) {
    .figures {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .skill-row {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.5rem;
    }
  }
</style>

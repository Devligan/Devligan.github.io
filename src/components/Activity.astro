---
import SectionHead from './SectionHead.astro';
import { ago, data, recentCommits, shortDate, stats } from '../lib/view.mjs';

const cal = data.calendar;
const CELL = 11;
const GAP = 3;
const STEP = CELL + GAP;
const TOP = 18;

type Day = [string, number];
let levels = [1, 2, 3, 4];
let best: Day = ['', 0];
const months: { x: number; label: string }[] = [];
if (cal) {
  const days = cal.weeks.flat() as Day[];
  const nonzero = days.map(([, n]) => n).filter((n) => n > 0).sort((a, b) => a - b);
  const q = (p: number) => nonzero[Math.min(nonzero.length - 1, Math.floor(nonzero.length * p))] ?? 1;
  levels = [q(0.25), q(0.5), q(0.75), q(0.95)];
  for (const d of days) if (d[1] > best[1]) best = d;
  let lastMonth = -1;
  (cal.weeks as Day[][]).forEach((week, i) => {
    const m = new Date(week[0][0]).getUTCMonth();
    if (m !== lastMonth && i < cal.weeks.length - 2) {
      months.push({ x: i * STEP, label: shortDate(week[0][0], { month: 'short' }) });
      lastMonth = m;
    }
  });
  if (months[1] && months[1].x - months[0].x < STEP * 3) months.shift();
}
const tone = (n: number) => (n === 0 ? 0 : n <= levels[0] ? 1 : n <= levels[1] ? 2 : n <= levels[2] ? 3 : 4);
const width = cal ? cal.weeks.length * STEP : 0;
const height = TOP + 7 * STEP;
---

<section class="section" id="activity" aria-labelledby="activity-title">
  <div class="wrap">
    <SectionHead index="04 — Activity" title="Activity" note="What I've been shipping lately, straight from my commits." id="activity-title" />

    {
      cal && (
        <div class="map reveal">
          <div class="map-head">
            <p>
              <strong class="mono">{cal.total}</strong> contributions in the last year
            </p>
            {best[1] > 0 && (
              <p>
                Busiest day <strong class="mono">{best[1]}</strong> on {shortDate(best[0])}
              </p>
            )}
            <p>
              Longest streak <strong class="mono">{stats.longest}</strong> days
            </p>
          </div>
          <div class="map-scroll" data-scroll-end>
            <svg viewBox={`0 0 ${width} ${height}`} width={width} height={height} role="img" aria-label={`Contribution calendar: ${cal.total} contributions in the last year`}>
              {months.map((m) => (
                <text x={m.x} y="11" class="month">
                  {m.label}
                </text>
              ))}
              {(cal.weeks as Day[][]).map((week, wi) =>
                week.map(([date, n]) => (
                  <rect x={wi * STEP} y={TOP + new Date(date).getUTCDay() * STEP} width={CELL} height={CELL} rx="2" class={`t${tone(n)}`}>
                    <title>{`${shortDate(date)}: ${n} contribution${n === 1 ? '' : 's'}`}</title>
                  </rect>
                )),
              )}
            </svg>
          </div>
          <div class="legend mono" aria-hidden="true">
            Less
            {[0, 1, 2, 3, 4].map((t) => (
              <i class={`t${t}`} />
            ))}
            More
          </div>
        </div>
      )
    }

    <div class="commits reveal">
      <h3 class="commits-title">Recent commits</h3>
      <ol>
        {
          recentCommits.map((c) => (
            <li>
              <a href={c.url} target="_blank" rel="noopener">
                <span class="c-repo mono">{c.title}</span>
                <span class="c-msg">{c.message}</span>
                <span class="c-when mono" data-ago={c.date}>
                  {ago(c.date)}
                </span>
              </a>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .map {
    padding: 22px 22px 16px;
    background: var(--panel);
    border: 1px solid var(--line);
    border-radius: 14px;
  }

  .map-head {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem 2.2rem;
    margin-bottom: 1.1rem;
    font-size: 0.9rem;
    color: var(--dim);
  }

  .map-head strong {
    font-weight: 500;
    font-size: 1.05rem;
    color: var(--text);
  }

  .map-scroll {
    overflow-x: auto;
    padding-bottom: 4px;
  }

  .map svg {
    width: 100%;
    min-width: 640px;
    height: auto;
  }

  .month {
    font: 400 10px var(--mono);
    fill: var(--faint);
  }

  .t0 {
    fill: #1b1e24;
    background: #1b1e24;
  }
  .t1 {
    fill: #4a3a1a;
    background: #4a3a1a;
  }
  .t2 {
    fill: #7d5f22;
    background: #7d5f22;
  }
  .t3 {
    fill: #b8862e;
    background: #b8862e;
  }
  .t4 {
    fill: #f2b544;
    background: #f2b544;
  }

  .map rect:hover {
    stroke: var(--text);
    stroke-width: 1;
  }

  .legend {
    display: flex;
    justify-content: flex-end;
    align-items: center;
    gap: 4px;
    margin-top: 0.7rem;
    font-size: 0.72rem;
    color: var(--faint);
  }

  .legend i {
    width: 11px;
    height: 11px;
    border-radius: 2px;
  }

  .legend i:first-of-type {
    margin-left: 4px;
  }

  .legend i:last-of-type {
    margin-right: 4px;
  }

  .commits {
    margin-top: clamp(32px, 4vw, 48px);
  }

  .commits-title {
    margin-bottom: 0.75rem;
    font-size: 1.9rem;
  }

  .commits ol {
    margin: 0;
    padding: 0;
    list-style: none;
    border-top: 1px solid var(--line);
  }

  .commits a {
    display: grid;
    grid-template-columns: 11rem minmax(0, 1fr) 6rem;
    gap: 1.25rem;
    align-items: baseline;
    padding: 0.85rem 0.5rem;
    text-decoration: none;
    border-bottom: 1px solid var(--line);
    transition: background 0.15s;
  }

  .commits a:hover {
    background: rgba(255, 255, 255, 0.02);
  }

  .commits a:hover .c-msg {
    color: var(--accent);
  }

  .c-repo {
    font-size: 0.8rem;
    color: var(--faint);
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .c-msg {
    overflow-wrap: anywhere;
  }

  .c-when {
    text-align: right;
    font-size: 0.8rem;
    color: var(--faint);
  }

  @media (max-width: 640px) {
    .commits a {
      grid-template-columns: minmax(0, 1fr) auto;
      gap: 0.25rem 1rem;
    }
    .c-msg {
      grid-column: 1 / -1;
      grid-row: 2;
    }
  }
</style>

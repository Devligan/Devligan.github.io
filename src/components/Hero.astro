---
import { profile, shortDate, stats, weekly } from '../lib/view.mjs';

// Cumulative contributions over the year, drawn like an equity curve.
const W = 560;
const H = 220;
const PAD = { t: 16, r: 8, b: 26, l: 8 };
const max = Math.max(1, weekly.at(-1)?.cumulative ?? 1) * 1.08;
const x = (i: number) => PAD.l + (i / Math.max(1, weekly.length - 1)) * (W - PAD.l - PAD.r);
const y = (v: number) => PAD.t + (1 - v / max) * (H - PAD.t - PAD.b);
const pts = weekly.map((w, i) => [x(i), y(w.cumulative)] as const);
const line = pts.map(([px, py], i) => `${i ? 'L' : 'M'}${px.toFixed(1)} ${py.toFixed(1)}`).join(' ');
const area = pts.length ? `${line} L${pts.at(-1)![0].toFixed(1)} ${H - PAD.b} L${pts[0][0].toFixed(1)} ${H - PAD.b} Z` : '';
const last = pts.at(-1);
const grid = [0.25, 0.5, 0.75].map((f) => PAD.t + f * (H - PAD.t - PAD.b));
const ticks = weekly.length ? [0, Math.floor(weekly.length / 2), weekly.length - 1] : [];
---

<section class="hero" id="top" aria-labelledby="hero-title">
  <div class="wrap hero-grid">
    <div class="hero-copy">
      <p class="kicker mono">Portfolio · {profile.name}</p>
      <h1 id="hero-title">{profile.headline}</h1>
      <p class="intro">{profile.intro}</p>
      <div class="cta">
        <a class="btn btn-primary" href="#projects">View projects</a>
        {profile.email && <a class="btn" href={`mailto:${profile.email}`}>Email me</a>}
        {profile.linkedin && (
          <a class="btn" href={profile.linkedin} target="_blank" rel="noopener">
            LinkedIn <span class="arrow">↗</span>
          </a>
        )}
      </div>
      <ul class="tags stack" aria-label="Main stack">
        {profile.stack.map((s: string) => <li class="tag">{s}</li>)}
      </ul>
    </div>

    {
      weekly.length > 0 && (
        <figure class="chart reveal">
          <figcaption class="chart-head">
            <div>
              <p class="label">GitHub contributions, 12M</p>
              <p class="chart-value mono">{stats.contributions?.toLocaleString('en-US')}</p>
            </div>
            <div class="chart-side mono">
              <p>
                7D <strong>{stats.last7}</strong>
              </p>
              <p class={stats.delta > 0 ? 'up' : stats.delta < 0 ? 'down' : ''} title="Change vs. the 7 days before">
                {stats.delta > 0 ? '▲' : stats.delta < 0 ? '▼' : '■'} {Math.abs(stats.delta)} w/w
              </p>
            </div>
          </figcaption>
          <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={`Weekly GitHub contributions over the last year, ${stats.contributions} in total`}>
            <defs>
              <linearGradient id="fill" x1="0" y1="0" x2="0" y2="1">
                <stop offset="0" stop-color="#f2b544" stop-opacity="0.32" />
                <stop offset="1" stop-color="#f2b544" stop-opacity="0" />
              </linearGradient>
            </defs>
            {grid.map((gy) => (
              <line class="grid" x1={PAD.l} x2={W - PAD.r} y1={gy} y2={gy} />
            ))}
            <path class="area" d={area} fill="url(#fill)" />
            <path class="line" d={line} pathLength="1" />
            {last && <circle class="last" cx={last[0]} cy={last[1]} r="4" />}
            {ticks.map((i) => (
              <text class="tick" x={x(i)} y={H - 6} text-anchor={i === 0 ? 'start' : i === weekly.length - 1 ? 'end' : 'middle'}>
                {shortDate(weekly[i].start, { month: 'short', year: '2-digit' })}
              </text>
            ))}
          </svg>
        </figure>
      )
    }
  </div>
</section>

<style>
  .hero {
    position: relative;
    padding: clamp(56px, 9vw, 112px) 0 clamp(24px, 4vw, 40px);
    overflow: hidden;
    isolation: isolate;
  }

  /* Faint graph paper, fading out. */
  .hero::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(var(--line) 1px, transparent 1px),
      linear-gradient(90deg, var(--line) 1px, transparent 1px);
    background-size: 48px 48px;
    opacity: 0.35;
    mask-image: radial-gradient(ellipse 70% 80% at 30% 20%, #000 20%, transparent 75%);
  }

  .hero::after {
    content: '';
    position: absolute;
    right: -10%;
    top: -20%;
    z-index: -1;
    width: 60%;
    aspect-ratio: 1;
    background: radial-gradient(circle, rgba(242, 181, 68, 0.1), transparent 65%);
  }

  .hero-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.15fr) minmax(0, 1fr);
    gap: clamp(32px, 5vw, 72px);
    align-items: center;
  }

  .kicker {
    font-size: 0.8rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    color: var(--accent);
  }

  h1 {
    margin-top: 1rem;
    font-size: clamp(2.9rem, 6.6vw, 5.3rem);
    line-height: 0.98;
    text-wrap: balance;
  }

  .intro {
    max-width: 46ch;
    margin-top: 1.4rem;
    font-size: clamp(1.05rem, 1.6vw, 1.18rem);
    color: var(--dim);
  }

  .cta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
    margin-top: 2rem;
  }

  .stack {
    margin-top: 1.6rem;
  }

  /* ── Chart ── */

  .chart {
    margin: 0;
    padding: 20px 20px 12px;
    background: linear-gradient(180deg, var(--panel), var(--bg-2));
    border: 1px solid var(--line);
    border-radius: 14px;
    box-shadow: 0 30px 60px -30px rgba(0, 0, 0, 0.8);
  }

  .chart-head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
    margin-bottom: 0.75rem;
  }

  .chart-value {
    margin-top: 0.3rem;
    font-size: 2.4rem;
    line-height: 1;
    letter-spacing: -0.02em;
  }

  .chart-side {
    white-space: nowrap;
    text-align: right;
    font-size: 0.78rem;
    color: var(--faint);
  }

  .chart-side strong {
    color: var(--text);
    font-weight: 500;
  }

  .chart svg {
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .grid {
    stroke: var(--line);
    stroke-dasharray: 2 4;
  }

  .line {
    fill: none;
    stroke: var(--accent);
    stroke-width: 1.8;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 0;
  }

  :global(.js) .chart:not(.is-in) .line {
    stroke-dashoffset: 1;
  }

  :global(.js) .chart .line {
    transition: stroke-dashoffset 1.8s cubic-bezier(0.3, 0.6, 0.2, 1) 0.2s;
  }

  .tick {
    font: 400 11px var(--mono);
    fill: var(--faint);
  }

  .last {
    fill: var(--bg);
    stroke: var(--accent);
    stroke-width: 2;
  }

  @media (max-width: 900px) {
    .hero-grid {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>

---
import { ago, data, profile, stats } from '../lib/view.mjs';

const [first, ...rest] = profile.name.split(' ');
const last = rest.join(' ');
const menu = [
  { href: '#experience', label: 'Experience' },
  { href: '#projects', label: 'Projects' },
  { href: '#about', label: 'About' },
  { href: '#contact', label: 'Contact' },
];
// Words that circle the name.
const ring = 'SOFTWARE ENGINEER ✦ FINTECH ✦ TRADING SYSTEMS ✦ MARKET DATA ✦ RISK ✦ HOUSTON ✦ ';
const ticks = Array.from({ length: 72 }, (_, i) => i * 5);
---

<section class="hero" id="top" aria-labelledby="hero-name">
  <div class="sigil" aria-hidden="true">
    <svg viewBox="0 0 600 600">
      <defs>
        <path id="ring-path" d="M300,300 m-232,0 a232,232 0 1,1 464,0 a232,232 0 1,1 -464,0" />
        <radialGradient id="sigil-glow">
          <stop offset="0" stop-color="#f3cf7a" stop-opacity="0.16" />
          <stop offset="1" stop-color="#f3cf7a" stop-opacity="0" />
        </radialGradient>
      </defs>
      <circle cx="300" cy="300" r="290" fill="url(#sigil-glow)" />
      <g class="spin-slow">
        <circle cx="300" cy="300" r="270" class="ring" />
        {ticks.map((deg) => <line x1="300" y1="34" x2="300" y2={deg % 30 === 0 ? 48 : 40} transform={`rotate(${deg} 300 300)`} class="tick" />)}
        <text class="ring-text">
          <textPath href="#ring-path" textLength="1440">{ring}{ring}</textPath>
        </text>
      </g>
      <g class="spin-rev">
        <circle cx="300" cy="300" r="205" class="ring ring-dash" />
        <ellipse cx="300" cy="300" rx="205" ry="70" class="ring orbit" transform="rotate(-24 300 300)" />
        <circle cx="300" cy="300" r="5" class="sat" transform="rotate(-24 300 300) translate(205 0)" />
      </g>
    </svg>
  </div>

  <div class="wrap hero-inner">
    <p class="eyebrow hero-eyebrow">Portfolio</p>
    <h1 id="hero-name" class="name">
      <span class="gold-text">{first}</span>
      <span class="gold-text">{last}</span>
    </h1>
    <div class="role">
      <span class="role-line" aria-hidden="true"></span>
      <span>{profile.role}</span>
      <span class="role-line" aria-hidden="true"></span>
    </div>
    <p class="headline">{profile.headline}</p>

    <nav class="menu frame" aria-label="Sections">
      {
        menu.map((m) => (
          <a href={m.href}>
            <span class="cursor" aria-hidden="true">▸</span>
            {m.label}
          </a>
        ))
      }
    </nav>

    <p class="synced">
      <span class="live-dot" aria-hidden="true"></span>
      Synced from GitHub <span data-ago={data.generatedAt}>{ago(data.generatedAt)}</span>
      <span class="sep">·</span>
      <span class="num">{stats.commits}</span> commits
      {
        stats.contributions !== null && (
          <>
            <span class="sep">·</span>
            <span class="num">{stats.contributions}</span> contributions this year
          </>
        )
      }
    </p>
  </div>

  <a class="scroll-cue" href="#experience" aria-label="Scroll to experience">
    <span></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 100svh;
    padding: 96px 0 120px;
    overflow: hidden;
    isolation: isolate;
  }

  /* Nebula glow behind everything. */
  .hero::before {
    content: '';
    position: absolute;
    inset: -20% -10% 0;
    z-index: -2;
    background:
      radial-gradient(ellipse 45% 35% at 50% 46%, rgba(243, 207, 122, 0.1), transparent 70%),
      radial-gradient(ellipse 40% 40% at 18% 70%, rgba(139, 123, 255, 0.18), transparent 70%),
      radial-gradient(ellipse 40% 40% at 85% 25%, rgba(143, 220, 255, 0.1), transparent 70%);
  }

  /* Big enough that the lettered ring frames the content instead of crossing it. */
  .sigil {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: -1;
    width: max(1180px, 118vh);
    aspect-ratio: 1;
    transform: translate(-50%, -50%);
    opacity: 0.8;
  }

  @media (max-width: 700px) {
    .sigil {
      width: 200vw;
      opacity: 0.45;
    }
  }

  .sigil svg {
    width: 100%;
    height: 100%;
    overflow: visible;
  }

  .ring {
    fill: none;
    stroke: rgba(243, 207, 122, 0.28);
    stroke-width: 1;
  }

  .ring-dash {
    stroke-dasharray: 2 7;
    stroke: rgba(243, 207, 122, 0.35);
  }

  .orbit {
    stroke: rgba(143, 220, 255, 0.28);
  }

  .sat {
    fill: var(--cyan);
    filter: drop-shadow(0 0 6px var(--cyan));
  }

  .tick {
    stroke: rgba(243, 207, 122, 0.35);
    stroke-width: 1;
  }

  .ring-text {
    font: 600 13px var(--display);
    letter-spacing: 0.32em;
    fill: rgba(243, 207, 122, 0.4);
  }

  .spin-slow {
    transform-origin: 300px 300px;
    animation: spin 160s linear infinite;
  }

  .spin-rev {
    transform-origin: 300px 300px;
    animation: spin 90s linear infinite reverse;
  }

  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .name {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 1.1rem;
    font-size: clamp(2.7rem, 9.5vw, 7.4rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: 0.06em;
    filter: drop-shadow(0 0 30px rgba(243, 207, 122, 0.3)) drop-shadow(0 4px 0 rgba(4, 5, 13, 0.8));
  }

  .name span {
    display: block;
  }

  :global(.js) .name span {
    animation: rise 1.4s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  :global(.js) .name span + span {
    animation-delay: 0.15s;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(18px);
      filter: blur(8px);
    }
  }

  .role {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1.4rem;
    font: 600 clamp(0.9rem, 2vw, 1.1rem) var(--display);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .role-line {
    width: clamp(36px, 8vw, 90px);
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--gold));
  }

  .role-line:last-child {
    background: linear-gradient(270deg, transparent, var(--gold));
  }

  .headline {
    max-width: 52ch;
    margin-top: 1.2rem;
    font-size: clamp(1rem, 1.8vw, 1.12rem);
    color: var(--dim);
  }

  .menu {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem;
    margin-top: 2.6rem;
    padding: 0.55rem 0.7rem;
  }

  .menu a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 1.1rem 0.6rem 0.8rem;
    font: 600 0.95rem/1 var(--display);
    letter-spacing: 0.08em;
    text-decoration: none;
    color: var(--text);
    border-radius: 999px;
    transition:
      color 0.2s,
      background 0.2s;
  }

  .cursor {
    width: 0.8em;
    color: var(--gold);
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity 0.2s,
      transform 0.2s;
  }

  .menu a:hover,
  .menu a:focus-visible {
    color: var(--gold);
    background: rgba(243, 207, 122, 0.07);
  }

  .menu a:hover .cursor,
  .menu a:focus-visible .cursor {
    opacity: 1;
    transform: none;
  }

  .synced {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.4rem;
    margin-top: 2rem;
    font-size: 0.82rem;
    color: var(--faint);
  }

  .synced .num {
    color: var(--dim);
    font-weight: 600;
  }

  .sep {
    opacity: 0.5;
  }

  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: 32px;
    width: 26px;
    height: 42px;
    margin-left: -13px;
    border: 1px solid var(--line);
    border-radius: 999px;
  }

  .scroll-cue span {
    position: absolute;
    left: 50%;
    top: 9px;
    width: 3px;
    height: 8px;
    margin-left: -1.5px;
    border-radius: 2px;
    background: var(--gold);
    animation: cue 2s ease-in-out infinite;
  }

  @keyframes cue {
    60% {
      transform: translateY(12px);
      opacity: 0;
    }
  }

  @media (max-width: 560px) {
    .menu a {
      padding: 0.55rem 0.8rem 0.55rem 0.6rem;
      font-size: 0.85rem;
    }
    .cursor {
      display: none;
    }
  }
</style>

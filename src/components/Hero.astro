---
import { profile } from '../lib/view.mjs';

const [first, ...rest] = profile.name.split(' ');
const last = rest.join(' ');
const menu = [
  { href: '#experience', label: 'Experience' },
  { href: '#projects', label: 'Projects' },
  { href: '#about', label: 'About' },
  { href: '#contact', label: 'Contact' },
];
const links = [
  profile.linkedin && { label: 'LinkedIn', href: profile.linkedin },
  { label: 'GitHub', href: `https://github.com/${profile.handle}` },
  profile.email && { label: 'Email', href: `mailto:${profile.email}` },
  profile.resume && { label: 'Résumé', href: profile.resume },
].filter(Boolean) as { label: string; href: string }[];

// Three tilted orbits around the name, each with a satellite moving along it.
const CX = 500;
const CY = 300;
const orbits = [
  { id: 'o1', rx: 470, ry: 118, tilt: -11, dur: 42, tone: 'gold', reverse: false },
  { id: 'o2', rx: 395, ry: 170, tilt: 17, dur: 28, tone: 'cyan', reverse: true },
  { id: 'o3', rx: 540, ry: 64, tilt: 4, dur: 64, tone: 'faint', reverse: false },
].map((o) => ({
  ...o,
  d: o.reverse
    ? `M${CX + o.rx} ${CY} a${o.rx} ${o.ry} 0 1 0 ${-2 * o.rx} 0 a${o.rx} ${o.ry} 0 1 0 ${2 * o.rx} 0`
    : `M${CX - o.rx} ${CY} a${o.rx} ${o.ry} 0 1 0 ${2 * o.rx} 0 a${o.rx} ${o.ry} 0 1 0 ${-2 * o.rx} 0`,
}));
---

<section class="hero" id="top" aria-labelledby="hero-name">
  <div class="orbits" aria-hidden="true">
    <svg viewBox="0 0 1000 600" preserveAspectRatio="xMidYMid slice">
      {
        orbits.map((o) => (
          <g transform={`rotate(${o.tilt} ${CX} ${CY})`} class={`orbit orbit-${o.tone}`}>
            <path id={o.id} d={o.d} class="path" />
            <circle r="2.5" class="sat">
              <animateMotion dur={`${o.dur}s`} repeatCount="indefinite">
                <mpath href={`#${o.id}`} />
              </animateMotion>
            </circle>
          </g>
        ))
      }
    </svg>
  </div>

  <div class="wrap hero-inner">
    <h1 id="hero-name" class="name">
      <span class="gold-text">{first}</span>
      <span class="gold-text">{last}</span>
    </h1>
    <p class="role">{profile.role}</p>
    <p class="headline">{profile.headline}</p>

    <nav class="menu frame" aria-label="Sections">
      {
        menu.map((m) => (
          <a href={m.href}>
            <span class="cursor" aria-hidden="true">▸</span>
            {m.label}
          </a>
        ))
      }
    </nav>

    <p class="reach">
      {profile.location && <span>{profile.location}</span>}
      {
        links.map((l) => (
          <>
            <span class="sep">·</span>
            <a href={l.href} target={l.href.startsWith('http') ? '_blank' : undefined} rel="noopener">
              {l.label}
            </a>
          </>
        ))
      }
    </p>
  </div>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 100svh;
    padding: 96px 0;
    overflow: hidden;
    isolation: isolate;
  }

  .orbits {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .orbits svg {
    width: 100%;
    height: 100%;
  }

  .path {
    fill: none;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .orbit-gold .path {
    stroke: rgba(243, 207, 122, 0.28);
  }

  .orbit-cyan .path {
    stroke: rgba(143, 220, 255, 0.22);
  }

  .orbit-faint .path {
    stroke: rgba(238, 240, 255, 0.12);
    stroke-dasharray: 3 6;
  }

  .sat {
    fill: #fff;
  }

  .orbit-gold .sat {
    fill: var(--gold);
  }

  .orbit-cyan .sat {
    fill: var(--cyan);
  }

  @media (max-width: 700px) {
    .orbits {
      opacity: 0.6;
    }
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .name {
    display: flex;
    flex-direction: column;
    align-items: center;
    font-size: clamp(2.7rem, 9.5vw, 7.4rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: 0.06em;
  }

  .name span {
    display: block;
  }

  :global(.js) .name {
    animation: fade-in 1s ease both;
  }

  @keyframes fade-in {
    from {
      opacity: 0;
    }
  }

  .role {
    margin-top: 1.4rem;
    font: 600 clamp(0.9rem, 2vw, 1.1rem) var(--display);
    letter-spacing: 0.24em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .headline {
    max-width: 52ch;
    margin-top: 1rem;
    font-size: clamp(1rem, 1.8vw, 1.12rem);
    color: var(--dim);
  }

  .menu {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem;
    margin-top: 2.4rem;
    padding: 0.5rem 0.6rem;
  }

  .menu a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 1.1rem 0.6rem 0.8rem;
    font: 600 0.95rem/1 var(--display);
    letter-spacing: 0.08em;
    text-decoration: none;
    color: var(--text);
    border-radius: 6px;
    transition:
      color 0.2s,
      background 0.2s;
  }

  .cursor {
    width: 0.8em;
    color: var(--gold);
    opacity: 0;
    transition: opacity 0.2s;
  }

  .menu a:hover,
  .menu a:focus-visible {
    color: var(--gold);
    background: rgba(243, 207, 122, 0.06);
  }

  .menu a:hover .cursor,
  .menu a:focus-visible .cursor {
    opacity: 1;
  }

  .reach {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.5rem;
    margin-top: 2rem;
    font-size: 0.9rem;
    color: var(--faint);
  }

  .reach a {
    color: var(--dim);
    text-decoration: none;
    transition: color 0.2s;
  }

  .reach a:hover {
    color: var(--gold);
  }

  .sep {
    opacity: 0.5;
  }

  @media (max-width: 560px) {
    .menu a {
      padding: 0.55rem 0.8rem 0.55rem 0.6rem;
      font-size: 0.85rem;
    }
    .cursor {
      display: none;
    }
  }
</style>

---
import { ago, data, profile, stats } from '../lib/view.mjs';

const [first, ...rest] = profile.name.split(' ');
const last = rest.join(' ');
const menu = [
  { href: '#experience', label: 'Experience' },
  { href: '#projects', label: 'Projects' },
  { href: '#about', label: 'About' },
  { href: '#contact', label: 'Contact' },
];
// Tilted orbits around the name, each with a satellite riding it.
const CX = 500;
const CY = 300;
const orbits = [
  { id: 'o1', rx: 470, ry: 118, tilt: -11, dur: 42, tone: 'gold', reverse: false },
  { id: 'o2', rx: 395, ry: 170, tilt: 17, dur: 28, tone: 'cyan', reverse: true },
  { id: 'o3', rx: 540, ry: 64, tilt: 4, dur: 64, tone: 'faint', reverse: false },
].map((o) => ({
  ...o,
  d: o.reverse
    ? `M${CX + o.rx} ${CY} a${o.rx} ${o.ry} 0 1 0 ${-2 * o.rx} 0 a${o.rx} ${o.ry} 0 1 0 ${2 * o.rx} 0`
    : `M${CX - o.rx} ${CY} a${o.rx} ${o.ry} 0 1 0 ${2 * o.rx} 0 a${o.rx} ${o.ry} 0 1 0 ${-2 * o.rx} 0`,
}));
---

<section class="hero" id="top" aria-labelledby="hero-name">
  <div class="orbits" aria-hidden="true">
    <svg viewBox="0 0 1000 600" preserveAspectRatio="xMidYMid slice">
      <defs>
        <radialGradient id="core-glow">
          <stop offset="0" stop-color="#f3cf7a" stop-opacity="0.12" />
          <stop offset="1" stop-color="#f3cf7a" stop-opacity="0" />
        </radialGradient>
      </defs>
      <ellipse cx={CX} cy={CY} rx="380" ry="230" fill="url(#core-glow)" />
      {
        orbits.map((o) => (
          <g transform={`rotate(${o.tilt} ${CX} ${CY})`} class={`orbit orbit-${o.tone}`}>
            <path id={o.id} d={o.d} class="path" />
            <g class="sat">
              <circle r="9" class="sat-glow" />
              <circle r="3" class="sat-core" />
              <animateMotion dur={`${o.dur}s`} repeatCount="indefinite" rotate="auto">
                <mpath href={`#${o.id}`} />
              </animateMotion>
            </g>
          </g>
        ))
      }
    </svg>
  </div>

  <div class="wrap hero-inner">
    <p class="eyebrow hero-eyebrow">Portfolio</p>
    <h1 id="hero-name" class="name">
      <span class="gold-text">{first}</span>
      <span class="gold-text">{last}</span>
    </h1>
    <div class="role">
      <span class="role-line" aria-hidden="true"></span>
      <span>{profile.role}</span>
      <span class="role-line" aria-hidden="true"></span>
    </div>
    <p class="headline">{profile.headline}</p>

    <nav class="menu frame" aria-label="Sections">
      {
        menu.map((m) => (
          <a href={m.href}>
            <span class="cursor" aria-hidden="true">▸</span>
            {m.label}
          </a>
        ))
      }
    </nav>

    <p class="synced">
      <span class="live-dot" aria-hidden="true"></span>
      Synced from GitHub <span data-ago={data.generatedAt}>{ago(data.generatedAt)}</span>
      <span class="sep">·</span>
      <span class="num">{stats.commits}</span> commits
      {
        stats.contributions !== null && (
          <>
            <span class="sep">·</span>
            <span class="num">{stats.contributions}</span> contributions this year
          </>
        )
      }
    </p>
  </div>

  <a class="scroll-cue" href="#experience" aria-label="Scroll to experience">
    <span></span>
  </a>
</section>

<style>
  .hero {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 100svh;
    padding: 96px 0 120px;
    overflow: hidden;
    isolation: isolate;
  }

  /* Nebula glow behind everything. */
  .hero::before {
    content: '';
    position: absolute;
    inset: -20% -10% 0;
    z-index: -2;
    background:
      radial-gradient(ellipse 50% 40% at 50% 50%, rgba(40, 80, 190, 0.18), transparent 70%),
      radial-gradient(ellipse 40% 40% at 15% 75%, rgba(30, 70, 170, 0.16), transparent 70%),
      radial-gradient(ellipse 40% 40% at 88% 22%, rgba(143, 220, 255, 0.08), transparent 70%);
  }

  .orbits {
    position: absolute;
    inset: 0;
    z-index: -1;
  }

  .orbits svg {
    width: 100%;
    height: 100%;
  }

  .path {
    fill: none;
    stroke-width: 1;
    vector-effect: non-scaling-stroke;
  }

  .orbit-gold .path {
    stroke: rgba(243, 207, 122, 0.3);
  }

  .orbit-cyan .path {
    stroke: rgba(143, 220, 255, 0.24);
  }

  .orbit-faint .path {
    stroke: rgba(238, 240, 255, 0.12);
    stroke-dasharray: 3 6;
  }

  .sat-core {
    fill: #fff;
  }

  .sat-glow {
    opacity: 0.35;
  }

  .orbit-gold .sat-glow {
    fill: var(--gold);
  }

  .orbit-cyan .sat-glow {
    fill: var(--cyan);
  }

  .orbit-faint .sat-glow {
    fill: #fff;
    opacity: 0.18;
  }

  @media (max-width: 700px) {
    .orbits {
      opacity: 0.6;
    }
  }

  .hero-inner {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
  }

  .name {
    display: flex;
    flex-direction: column;
    align-items: center;
    margin-top: 1.1rem;
    font-size: clamp(2.7rem, 9.5vw, 7.4rem);
    font-weight: 700;
    line-height: 0.95;
    letter-spacing: 0.06em;
    filter: drop-shadow(0 0 30px rgba(243, 207, 122, 0.3)) drop-shadow(0 4px 0 rgba(4, 5, 13, 0.8));
  }

  .name span {
    display: block;
  }

  :global(.js) .name span {
    animation: rise 1.4s cubic-bezier(0.2, 0.7, 0.2, 1) both;
  }

  :global(.js) .name span + span {
    animation-delay: 0.15s;
  }

  @keyframes rise {
    from {
      opacity: 0;
      transform: translateY(18px);
      filter: blur(8px);
    }
  }

  .role {
    display: flex;
    align-items: center;
    gap: 1rem;
    margin-top: 1.4rem;
    font: 600 clamp(0.9rem, 2vw, 1.1rem) var(--display);
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .role-line {
    width: clamp(36px, 8vw, 90px);
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--gold));
  }

  .role-line:last-child {
    background: linear-gradient(270deg, transparent, var(--gold));
  }

  .headline {
    max-width: 52ch;
    margin-top: 1.2rem;
    font-size: clamp(1rem, 1.8vw, 1.12rem);
    color: var(--dim);
  }

  .menu {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.25rem;
    margin-top: 2.6rem;
    padding: 0.55rem 0.7rem;
  }

  .menu a {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    padding: 0.6rem 1.1rem 0.6rem 0.8rem;
    font: 600 0.95rem/1 var(--display);
    letter-spacing: 0.08em;
    text-decoration: none;
    color: var(--text);
    border-radius: 999px;
    transition:
      color 0.2s,
      background 0.2s;
  }

  .cursor {
    width: 0.8em;
    color: var(--gold);
    opacity: 0;
    transform: translateX(-4px);
    transition:
      opacity 0.2s,
      transform 0.2s;
  }

  .menu a:hover,
  .menu a:focus-visible {
    color: var(--gold);
    background: rgba(243, 207, 122, 0.07);
  }

  .menu a:hover .cursor,
  .menu a:focus-visible .cursor {
    opacity: 1;
    transform: none;
  }

  .synced {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    align-items: center;
    gap: 0.4rem;
    margin-top: 2rem;
    font-size: 0.82rem;
    color: var(--faint);
  }

  .synced .num {
    color: var(--dim);
    font-weight: 600;
  }

  .sep {
    opacity: 0.5;
  }

  .scroll-cue {
    position: absolute;
    left: 50%;
    bottom: 32px;
    width: 26px;
    height: 42px;
    margin-left: -13px;
    border: 1px solid var(--line);
    border-radius: 999px;
  }

  .scroll-cue span {
    position: absolute;
    left: 50%;
    top: 9px;
    width: 3px;
    height: 8px;
    margin-left: -1.5px;
    border-radius: 2px;
    background: var(--gold);
    animation: cue 2s ease-in-out infinite;
  }

  @keyframes cue {
    60% {
      transform: translateY(12px);
      opacity: 0;
    }
  }

  @media (max-width: 560px) {
    .menu a {
      padding: 0.55rem 0.8rem 0.55rem 0.6rem;
      font-size: 0.85rem;
    }
    .cursor {
      display: none;
    }
  }
</style>

---
import { profile } from '../lib/view.mjs';

const links = [
  { href: '#experience', label: 'Experience' },
  { href: '#projects', label: 'Projects' },
  { href: '#about', label: 'About' },
  { href: '#contact', label: 'Contact' },
];
---

<header class="nav" data-nav-bar>
  <div class="wrap nav-inner">
    <a class="brand" href="#top">
      <span class="mark" aria-hidden="true"><span>SC</span></span>
      <span class="brand-name">{profile.name}</span>
    </a>
    <nav aria-label="Main">
      <ul>
        {
          links.map((l) => (
            <li>
              <a href={l.href} data-nav>
                {l.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<style>
  .nav {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 40;
    background: rgba(7, 10, 28, 0.72);
    -webkit-backdrop-filter: blur(14px);
    backdrop-filter: blur(14px);
    border-bottom: 1px solid var(--line-soft);
    transform: translateY(-100%);
    transition: transform 0.35s cubic-bezier(0.2, 0.7, 0.2, 1);
  }

  /* Hidden on the title screen; slides in once you scroll past it. */
  .nav:global(.is-shown),
  :global(html:not(.js)) .nav {
    transform: none;
  }

  .nav-inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    height: 64px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    text-decoration: none;
  }

  /* A gold diamond with the initials upright inside it. */
  .mark {
    display: grid;
    place-items: center;
    width: 30px;
    height: 30px;
    margin: 0 4px;
    border: 1px solid var(--line);
    border-radius: 6px;
    background: rgba(243, 207, 122, 0.06);
    transform: rotate(45deg);
  }

  .mark span {
    font: 700 0.72rem/1 var(--display);
    letter-spacing: 0.04em;
    color: var(--gold);
    transform: rotate(-45deg);
  }

  .brand-name {
    font: 600 1rem var(--display);
    letter-spacing: 0.06em;
  }

  ul {
    display: flex;
    gap: 0.2rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  ul a {
    display: block;
    padding: 0.45rem 0.85rem;
    font-size: 0.9rem;
    font-weight: 500;
    color: var(--dim);
    text-decoration: none;
    border-radius: 999px;
    transition:
      color 0.2s,
      background 0.2s;
  }

  ul a:hover,
  ul a:global(.is-active) {
    color: var(--gold);
    background: rgba(243, 207, 122, 0.07);
  }

  @media (max-width: 720px) {
    .brand-name {
      display: none;
    }
    ul a {
      padding: 0.45rem 0.6rem;
      font-size: 0.84rem;
    }
  }
</style>

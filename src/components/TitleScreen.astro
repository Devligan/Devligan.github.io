---
import Landscape from './Landscape.astro';
import Sprite from './Sprite.astro';
import { ago, data, hero } from '../lib/view.mjs';

const menu = [
  { href: '#quests', label: 'Main Quests', hint: 'Selected projects' },
  { href: '#status', label: 'Status', hint: 'About me' },
  { href: '#log', label: 'Quest Log', hint: 'Every repo' },
  { href: '#journey', label: 'Journey', hint: 'Recent work' },
  { href: '#save', label: 'Save Point', hint: 'Contact' },
];
const [first, last] = [hero.name.split(' ')[0], hero.name.split(' ').slice(1).join(' ')];
---

<section class="title-screen" id="top" aria-labelledby="hero-name">
  <canvas class="sky" aria-hidden="true"></canvas>

  <div class="hud wrap">
    <span class="pixel hud-file">FILE 01 · {hero.handle}</span>
    <div class="hud-right">
      <a class="sync pixel" href={`https://github.com/${hero.handle}`} title={`Synced ${data.generatedAt}`}>
        <span class="sync-dot" aria-hidden="true"></span>
        Synced from GitHub <span data-ago={data.generatedAt}>{ago(data.generatedAt)}</span>
      </a>
      <button class="sound pixel" type="button" aria-pressed="false" data-sound-toggle>
        <span aria-hidden="true">♪</span> Sound <span data-sound-label>off</span>
      </button>
    </div>
  </div>

  <div class="title-body wrap">
    <p class="kicker pixel">LV {hero.level} · {hero.class}</p>
    <h1 id="hero-name" class="title">
      <span>{first}</span>
      <span>{last}</span>
    </h1>
    <p class="role">
      <strong>{hero.role}</strong>. I build full-stack web apps and data/ML tools.
    </p>
    <ul class="chips stack" aria-label="Main stack">
      {hero.stack.map((s) => <li class="chip">{s}</li>)}
    </ul>

    <div class="console">
      <nav class="win menu" aria-label="Sections">
        <span class="win-title">Menu</span>
        <ol>
          {
            menu.map((m, i) => (
              <li>
                <a class="cursorable" href={m.href} data-menu-item>
                  <span class="menu-label pixel">{m.label}</span>
                  <span class="menu-hint">{m.hint}</span>
                  <kbd class="pixel" aria-hidden="true">{i + 1}</kbd>
                </a>
              </li>
            ))
          }
        </ol>
      </nav>

      <div class="win dialog" data-dialog>
        <div class="portrait" aria-hidden="true">
          <Sprite scale={4} />
        </div>
        <div class="dialog-text">
          <p class="speaker pixel">{first}</p>
          <div class="lines">
            {hero.intro.map((line, i) => <p data-line={i}>{line}</p>)}
          </div>
          <button class="next" type="button" aria-label="Next line" data-dialog-next>▼</button>
        </div>
      </div>
    </div>
  </div>

  <Landscape />
</section>

<style>
  .title-screen {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 100svh;
    padding-bottom: clamp(130px, 19vw, 280px);
    background:
      radial-gradient(ellipse 80% 60% at 70% 100%, rgba(94, 70, 200, 0.28), transparent 70%),
      linear-gradient(180deg, #05051a 0%, #0b0a2a 55%, #1a1450 100%);
    overflow: hidden;
    isolation: isolate;
  }

  .sky {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .hud {
    position: relative;
    z-index: 2;
    display: flex;
    justify-content: space-between;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.75rem;
    padding-top: 18px;
    font-size: 0.82rem;
    color: var(--ink-faint);
  }

  .hud-right {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .sync,
  .sound {
    display: inline-flex;
    align-items: center;
    gap: 0.5em;
    padding: 0.35em 0.75em;
    font-size: 0.8rem;
    color: var(--ink-dim);
    text-decoration: none;
    background: rgba(3, 2, 13, 0.45);
    border: 1px solid rgba(195, 189, 224, 0.22);
    border-radius: 3px;
    cursor: pointer;
  }

  .sync:hover,
  .sound:hover {
    color: var(--ink);
    border-color: var(--ink-faint);
  }

  .sound[aria-pressed='true'] {
    color: var(--gold);
    border-color: rgba(255, 207, 90, 0.5);
  }

  .sync-dot {
    width: 7px;
    height: 7px;
    background: var(--hp);
    box-shadow: 0 0 8px var(--hp);
    animation: pulse 2s steps(2) infinite;
  }

  @keyframes pulse {
    50% {
      opacity: 0.4;
    }
  }

  .title-body {
    position: relative;
    z-index: 2;
    flex: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding-top: clamp(28px, 6vh, 64px);
    padding-bottom: 24px;
  }

  .kicker {
    color: var(--gold);
    font-size: 0.85rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
  }

  .title {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    column-gap: 0.32em;
    margin: 0.2em 0 0.15em;
    font-size: clamp(2.6rem, 9vw, 6.4rem);
    line-height: 1;
    letter-spacing: 0.02em;
    color: #fff6dc;
    background: linear-gradient(180deg, #fffaf0 0%, #ffe9a8 48%, #f3b84a 52%, #ffcf5a 100%);
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    filter: drop-shadow(0 4px 0 #3a1f0b) drop-shadow(0 0 30px rgba(255, 207, 90, 0.25));
  }

  .role {
    max-width: 40ch;
    font-size: clamp(1.02rem, 2.2vw, 1.2rem);
    color: var(--ink-dim);
  }

  .role strong {
    color: var(--ink);
    font-weight: 600;
  }

  .stack {
    justify-content: center;
    margin-top: 1rem;
  }

  .console {
    display: grid;
    grid-template-columns: minmax(230px, 280px) minmax(0, 560px);
    gap: 28px;
    align-items: stretch;
    margin-top: clamp(28px, 5vh, 48px);
    text-align: left;
  }

  .menu ol {
    margin: 0.35rem 0 0;
    padding: 0 0 0 18px;
    list-style: none;
  }

  .menu a {
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: baseline;
    column-gap: 0.75rem;
    padding: 0.32rem 0;
    text-decoration: none;
  }

  .menu-label {
    font-size: 1.12rem;
  }

  .menu-hint {
    grid-column: 1;
    font-size: 0.78rem;
    line-height: 1.2;
    color: var(--ink-faint);
  }

  .menu kbd {
    grid-row: 1 / span 2;
    grid-column: 2;
    align-self: center;
    padding: 0 0.4em;
    font-size: 0.72rem;
    color: var(--ink-faint);
    border: 1px solid rgba(195, 189, 224, 0.25);
    border-radius: 2px;
  }

  .menu a:hover .menu-label,
  .menu a:focus-visible .menu-label,
  .menu a.is-active .menu-label {
    color: var(--gold);
  }

  .dialog {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 1.1rem;
    align-items: start;
  }

  .portrait {
    padding: 6px;
    background: rgba(3, 2, 13, 0.5);
    border: 2px solid rgba(239, 230, 207, 0.4);
    border-radius: 4px;
  }

  .dialog-text {
    position: relative;
    min-height: 7.5em;
    padding-bottom: 1.2rem;
  }

  .speaker {
    color: var(--gold);
    font-size: 0.95rem;
    margin-bottom: 0.25rem;
  }

  .lines p {
    font-family: var(--pixel);
    font-size: 1.04rem;
    line-height: 1.6;
  }

  .lines p + p {
    margin-top: 0.4em;
  }

  /* With JS, lines are typed out in turn; earlier lines dim once read. */
  .lines :global(.rest) {
    visibility: hidden;
  }

  .lines :global(p.is-past) {
    color: var(--ink-dim);
  }

  .dialog {
    cursor: pointer;
  }

  .next {
    position: absolute;
    right: 0;
    bottom: 0;
    padding: 0 4px;
    font-size: 0.8rem;
    color: var(--gold);
    background: none;
    border: 0;
    cursor: pointer;
    animation: nudge 0.8s steps(2) infinite;
  }

  :global(html:not(.js)) .next,
  .next[hidden] {
    display: none;
  }

  @keyframes nudge {
    50% {
      transform: translateY(3px);
    }
  }

  @media (max-width: 820px) {
    .console {
      grid-template-columns: 1fr;
      width: 100%;
      max-width: 560px;
    }
    .menu {
      order: 2;
    }
  }

  @media (max-width: 480px) {
    .hud-file {
      display: none;
    }
    .dialog {
      grid-template-columns: 1fr;
    }
    .portrait {
      display: none;
    }
  }
</style>

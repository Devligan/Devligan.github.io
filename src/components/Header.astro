---
import { data, profile, ticker } from '../lib/view.mjs';

const links = [
  { href: '#projects', label: 'Projects' },
  { href: '#about', label: 'About' },
  { href: '#repos', label: 'Repositories' },
  { href: '#activity', label: 'Activity' },
  { href: '#contact', label: 'Contact' },
];
const initials = profile.name
  .split(' ')
  .map((w: string) => w[0])
  .join('');
---

<header class="header">
  <nav class="nav wrap" aria-label="Main">
    <a class="brand" href="#top" aria-label={`${profile.name}, back to top`}>
      <span class="mark">{initials}</span>
      <span class="brand-name">{profile.name}</span>
    </a>
    <ul class="links">
      {
        links.map((l) => (
          <li>
            <a href={l.href} data-nav>
              {l.label}
            </a>
          </li>
        ))
      }
    </ul>
    <div class="nav-cta">
      {profile.resume && <a class="btn" href={profile.resume}>Résumé</a>}
      <a class="btn" href={`https://github.com/${profile.handle}`} target="_blank" rel="noopener">GitHub <span class="arrow">↗</span></a>
    </div>
  </nav>
</header>

<div class="ticker" aria-label="Live stats from GitHub">
  <div class="ticker-badge mono">
    <span class="live-dot" aria-hidden="true"></span>
    LIVE
  </div>
  <div class="ticker-track" data-ticker>
    {
      [0, 1].map((copy) => (
        <ul class="ticker-list mono" aria-hidden={copy === 1 ? 'true' : undefined}>
          {ticker.map((t: any) => (
            <li title={t.title}>
              <span class="sym">{t.sym}</span>
              <span class="val" data-ago-short={t.ago}>
                {t.value}
              </span>
              {t.delta !== undefined && (
                <span class={t.delta > 0 ? 'up' : t.delta < 0 ? 'down' : 'flat'}>
                  {t.delta > 0 ? '▲' : t.delta < 0 ? '▼' : '■'} {Math.abs(t.delta)}
                </span>
              )}
            </li>
          ))}
        </ul>
      ))
    }
  </div>
  <a class="ticker-src mono" href="#activity" title={`Synced ${data.generatedAt}`}>
    Synced <span data-ago={data.generatedAt}>…</span>
  </a>
</div>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgba(11, 12, 15, 0.78);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--line);
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 2rem;
    height: 64px;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
  }

  .mark {
    display: grid;
    place-items: center;
    width: 32px;
    height: 32px;
    font: italic 400 1.15rem/1 var(--serif);
    color: var(--accent-ink);
    background: var(--accent);
    border-radius: 7px;
  }

  .brand-name {
    font-weight: 500;
    font-size: 0.95rem;
    white-space: nowrap;
  }

  .links {
    display: flex;
    gap: 0.25rem;
    margin: 0 0 0 auto;
    padding: 0;
    list-style: none;
  }

  .links a {
    display: block;
    padding: 0.4rem 0.7rem;
    font-size: 0.88rem;
    color: var(--dim);
    text-decoration: none;
    border-radius: 6px;
    transition:
      color 0.15s,
      background 0.15s;
  }

  .links a:hover,
  .links a.is-active {
    color: var(--text);
    background: rgba(255, 255, 255, 0.04);
  }

  .nav-cta {
    display: flex;
    gap: 0.5rem;
  }

  .nav-cta .btn {
    padding: 0.5em 0.9em;
    font-size: 0.84rem;
  }

  @media (max-width: 900px) {
    .links {
      display: none;
    }
    .nav-cta {
      margin-left: auto;
    }
  }

  @media (max-width: 420px) {
    .brand-name {
      display: none;
    }
  }

  /* ── Ticker ── */

  .ticker {
    display: flex;
    align-items: center;
    height: 38px;
    font-size: 0.78rem;
    border-bottom: 1px solid var(--line);
    background: var(--bg-2);
  }

  .ticker-badge,
  .ticker-src {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    height: 100%;
    padding: 0 var(--gutter);
    flex: none;
    color: var(--faint);
    white-space: nowrap;
  }

  .ticker-badge {
    color: var(--up);
    letter-spacing: 0.1em;
    border-right: 1px solid var(--line);
  }

  .ticker-src {
    text-decoration: none;
    border-left: 1px solid var(--line);
  }

  .ticker-src:hover {
    color: var(--text);
  }

  .ticker-track {
    display: flex;
    flex: 1;
    overflow: hidden;
    mask-image: linear-gradient(90deg, transparent, #000 4%, #000 96%, transparent);
  }

  .ticker-list {
    display: flex;
    flex: none;
    gap: 2.2rem;
    margin: 0;
    padding: 0 1.1rem;
    list-style: none;
    white-space: nowrap;
    animation: tape 60s linear infinite;
  }

  .ticker-track:hover .ticker-list {
    animation-play-state: paused;
  }

  .ticker-list li {
    display: flex;
    gap: 0.5rem;
  }

  .sym {
    color: var(--faint);
  }

  .val {
    color: var(--text);
  }

  .flat {
    color: var(--faint);
  }

  @keyframes tape {
    to {
      transform: translateX(-100%);
    }
  }

  @media (max-width: 640px) {
    .ticker-src {
      display: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ticker-track {
      overflow-x: auto;
    }
    .ticker-list[aria-hidden] {
      display: none;
    }
  }
</style>

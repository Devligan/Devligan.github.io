---
import { data, profile, shortDate } from '../lib/view.mjs';

const links = [
  profile.email && { label: 'Email', value: profile.email, href: `mailto:${profile.email}`, primary: true },
  profile.linkedin && { label: 'LinkedIn', value: 'sriharsha-challangi', href: profile.linkedin },
  { label: 'GitHub', value: profile.handle, href: `https://github.com/${profile.handle}` },
  profile.resume && { label: 'Résumé', value: 'PDF', href: profile.resume },
].filter(Boolean) as { label: string; value: string; href: string; primary?: boolean }[];
---

<section class="section" id="contact" aria-labelledby="contact-title">
  <div class="wrap">
    <div class="contact frame reveal">
      <p class="eyebrow">Contact</p>
      <h2 id="contact-title" class="gold-text">Let’s talk</h2>
      <p class="note">Questions about a project, an opportunity, or ERCOT price spikes. Email is the fastest way to reach me.</p>
      <div class="links">
        {
          links.map((l) => (
            <a class={`btn ${l.primary ? 'btn-gold' : ''}`} href={l.href} target={l.href.startsWith('http') ? '_blank' : undefined} rel="noopener">
              {l.label}
              <span class="arrow" aria-hidden="true">
                →
              </span>
            </a>
          ))
        }
      </div>
      {profile.email && <p class="addr">{profile.email}</p>}
    </div>
  </div>
</section>

<footer class="footer">
  <div class="wrap footer-inner">
    <p>© {new Date(data.generatedAt).getUTCFullYear()} {profile.name} · {profile.location}</p>
    <p>
      Synced from GitHub {shortDate(data.generatedAt)} and rebuilt every hour ·
      <a href={`https://github.com/${profile.handle}/${profile.handle}.github.io`} target="_blank" rel="noopener">source</a>
    </p>
  </div>
</footer>

<style>
  .contact {
    display: grid;
    justify-items: center;
    gap: 1rem;
    padding: clamp(40px, 7vw, 80px) clamp(20px, 5vw, 64px);
    text-align: center;
    overflow: hidden;
    background:
      radial-gradient(ellipse 60% 70% at 50% 0%, rgba(243, 207, 122, 0.12), transparent 70%),
      linear-gradient(180deg, var(--panel), var(--panel-2));
  }

  h2 {
    font-size: clamp(2.6rem, 7vw, 4.6rem);
    filter: drop-shadow(0 0 26px rgba(243, 207, 122, 0.3));
  }

  .note {
    max-width: 46ch;
    color: var(--dim);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.7rem;
    margin-top: 1rem;
  }

  .addr {
    margin-top: 0.4rem;
    font-size: 0.86rem;
    color: var(--faint);
    user-select: all;
  }

  .footer {
    margin-top: clamp(72px, 9vw, 110px);
    padding: 26px 0 40px;
    border-top: 1px solid var(--line-soft);
    font-size: 0.84rem;
    color: var(--faint);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
  }

  .footer a {
    color: var(--dim);
  }
</style>

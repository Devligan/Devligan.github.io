---
import { data, profile } from '../lib/view.mjs';

const links = [
  profile.email && { label: 'Email', value: profile.email, href: `mailto:${profile.email}`, primary: true },
  profile.linkedin && { label: 'LinkedIn', value: 'sriharsha-challangi', href: profile.linkedin },
  { label: 'GitHub', value: profile.handle, href: `https://github.com/${profile.handle}` },
  profile.resume && { label: 'Résumé', value: 'PDF', href: profile.resume },
].filter(Boolean) as { label: string; value: string; href: string; primary?: boolean }[];
---

<section class="section" id="contact" aria-labelledby="contact-title">
  <div class="wrap">
    <div class="contact frame reveal">
      <h2 id="contact-title" class="gold-text">Contact</h2>
      {
        profile.email && (
          <p class="note">
            Email is the best way to reach me: <a href={`mailto:${profile.email}`}>{profile.email}</a>
          </p>
        )
      }
      <div class="links">
        {
          links.map((l) => (
            <a class={`btn ${l.primary ? 'btn-gold' : ''}`} href={l.href} target={l.href.startsWith('http') ? '_blank' : undefined} rel="noopener">
              {l.label}
            </a>
          ))
        }
      </div>
    </div>
  </div>
</section>

<footer class="footer">
  <div class="wrap footer-inner">
    <p>© {new Date(data.generatedAt).getUTCFullYear()} {profile.name} · {profile.location}</p>
    <p class="footer-links">
      {
        links.map((l) => (
          <a href={l.href} target={l.href.startsWith('http') ? '_blank' : undefined} rel="noopener">
            {l.label}
          </a>
        ))
      }
    </p>
  </div>
</footer>

<style>
  .contact {
    display: grid;
    justify-items: center;
    gap: 1rem;
    padding: clamp(40px, 7vw, 80px) clamp(20px, 5vw, 64px);
    text-align: center;
  }

  h2 {
    font-size: clamp(2rem, 5vw, 3.2rem);
    text-transform: uppercase;
    letter-spacing: 0.12em;
  }

  .note {
    color: var(--dim);
  }

  .note a {
    color: var(--text);
    text-underline-offset: 3px;
  }

  .note a:hover {
    color: var(--gold);
  }

  .links {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.7rem;
    margin-top: 1rem;
  }

  .footer {
    margin-top: clamp(72px, 9vw, 110px);
    padding: 26px 0 40px;
    border-top: 1px solid var(--line-soft);
    font-size: 0.84rem;
    color: var(--faint);
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.5rem 2rem;
  }

  .footer-links {
    display: flex;
    gap: 1.4rem;
  }

  .footer a {
    color: var(--dim);
    text-decoration: none;
  }

  .footer a:hover {
    color: var(--gold);
  }
</style>

---
import Banner from './Banner.astro';
import Crystal from './Crystal.astro';
import { data, hero, shortDate } from '../lib/view.mjs';

const links = [
  { label: 'GitHub', value: `@${hero.handle}`, href: `https://github.com/${hero.handle}` },
  hero.email && { label: 'Email', value: hero.email, href: `mailto:${hero.email}` },
  hero.linkedin && { label: 'LinkedIn', value: hero.linkedin.replace(/^https?:\/\/(www\.)?/, '').replace(/\/$/, ''), href: hero.linkedin },
  hero.resume && { label: 'Résumé', value: 'PDF', href: hero.resume },
].filter(Boolean) as { label: string; value: string; href: string }[];
---

<section class="chapter" id="save" aria-labelledby="save-title">
  <div class="wrap">
    <Banner kicker="Chapter V" title="Save Point" subtitle="Contact. Get in touch about a role, a project, or a weird ERCOT price spike." id="save-title" />

    <div class="save reveal">
      <button class="crystal-btn" type="button" data-save aria-label="Touch the save crystal">
        <Crystal scale={9} />
        <span class="crystal-glow" aria-hidden="true"></span>
      </button>

      <div class="win save-card">
        <span class="win-title">Leave a message</span>
        <p class="save-line pixel" data-save-line>The crystal hums softly. Touch it, or pick a channel below.</p>
        <ul class="channels">
          {
            links.map((l) => (
              <li>
                <a class="channel cursorable" href={l.href} target={l.href.startsWith('http') ? '_blank' : undefined} rel="noopener">
                  <span class="pixel channel-label">{l.label}</span>
                  <span class="channel-value">{l.value}</span>
                </a>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </div>
</section>

<footer class="footer">
  <div class="wrap footer-inner">
    <p>
      © {new Date(data.generatedAt).getUTCFullYear()} {hero.name}. Last synced from GitHub on {shortDate(data.generatedAt)}. Rebuilt every hour by
      GitHub Actions. Built with Astro, no trackers.
    </p>
    <p class="footer-links pixel">
      <a href={`https://github.com/${hero.handle}/${hero.handle}.github.io`} target="_blank" rel="noopener">Source</a>
      <a href="#top">↑ Title screen</a>
    </p>
    <p class="footer-secret pixel" aria-hidden="true">↑ ↑ ↓ ↓ ← → ← → B A</p>
  </div>
</footer>

<style>
  .save {
    display: grid;
    grid-template-columns: auto minmax(0, 560px);
    justify-content: center;
    align-items: center;
    gap: clamp(28px, 6vw, 72px);
  }

  .crystal-btn {
    position: relative;
    display: grid;
    place-items: center;
    padding: 24px;
    background: none;
    border: 0;
    cursor: pointer;
  }

  .crystal-btn :global(.crystal) {
    position: relative;
    z-index: 1;
    animation: float 2.4s steps(4) infinite;
    filter: drop-shadow(0 0 18px rgba(94, 230, 208, 0.55));
  }

  .crystal-glow {
    position: absolute;
    left: 50%;
    bottom: 6px;
    width: 90px;
    height: 16px;
    margin-left: -45px;
    background: radial-gradient(ellipse, rgba(94, 230, 208, 0.55), transparent 70%);
    animation: glow 2.4s steps(4) infinite;
  }

  .crystal-btn.is-saving :global(.crystal) {
    filter: drop-shadow(0 0 36px rgba(255, 255, 255, 0.95)) brightness(1.4);
  }

  @keyframes float {
    50% {
      transform: translateY(-10px);
    }
  }

  @keyframes glow {
    50% {
      transform: scaleX(0.7);
      opacity: 0.6;
    }
  }

  .save-card {
    padding-top: 1.6rem;
  }

  .save-line {
    min-height: 3.2em;
    font-size: 1.02rem;
    line-height: 1.6;
  }

  .channels {
    display: grid;
    gap: 0.25rem;
    margin: 1rem 0 0;
    padding: 0 0 0 20px;
    list-style: none;
  }

  .channel {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.2rem 1rem;
    padding: 0.4rem 0;
    text-decoration: none;
  }

  .channel-label {
    min-width: 6rem;
    font-size: 1.1rem;
  }

  .channel:hover .channel-label,
  .channel:focus-visible .channel-label {
    color: var(--gold);
  }

  .channel-value {
    color: var(--ink-dim);
    overflow-wrap: anywhere;
  }

  .footer {
    margin-top: clamp(80px, 10vw, 128px);
    padding: 28px 0 40px;
    border-top: 2px solid rgba(239, 230, 207, 0.1);
    background: linear-gradient(180deg, transparent, rgba(26, 20, 70, 0.45));
  }

  .footer-inner {
    display: grid;
    gap: 0.75rem;
    font-size: 0.85rem;
    color: var(--ink-faint);
  }

  .footer-links {
    display: flex;
    gap: 1.25rem;
  }

  .footer-links a {
    color: var(--ink-dim);
  }

  .footer-secret {
    font-size: 0.7rem;
    letter-spacing: 0.3em;
    color: rgba(141, 135, 184, 0.35);
  }

  @media (max-width: 720px) {
    .save {
      grid-template-columns: 1fr;
      justify-items: center;
    }
    .save-card {
      width: 100%;
    }
  }
</style>

---
import Banner from './Banner.astro';
import { ago, mainQuests, sideQuests } from '../lib/view.mjs';

const roman = ['I', 'II', 'III', 'IV', 'V', 'VI', 'VII', 'VIII', 'IX', 'X'];
const initials = (t: string) =>
  t
    .split(/\s+/)
    .map((w) => w[0])
    .join('')
    .slice(0, 2)
    .toUpperCase();
---

<section class="chapter" id="quests" aria-labelledby="quests-title">
  <div class="wrap">
    <Banner kicker="Chapter I" title="Main Quests" subtitle="Selected projects: the problem, how I built it, what it does." id="quests-title" />

    <ol class="quest-list">
      {
        mainQuests.map((q, i) => (
          <li class="quest win reveal" style={`--lang:${q.language?.color ?? '#8b8fb0'}`}>
            <div class="quest-art">
              {q.image ? (
                <img src={q.image} alt={`Screenshot of ${q.title}`} loading="lazy" decoding="async" />
              ) : (
                <div class="emblem" aria-hidden="true">
                  <span class="pixel">{initials(q.title)}</span>
                </div>
              )}
              <span class="quest-no pixel">Nº {roman[i] ?? i + 1}</span>
            </div>

            <div class="loot">
              <p class="loot-head pixel">Party composition</p>
              <div class="mix" role="img" aria-label={q.languages.map((l) => `${l.name} ${Math.round(l.pct)}%`).join(', ')}>
                {q.languages.map((l) => (
                  <span style={`--c:${l.color};flex-grow:${l.pct.toFixed(2)}`} />
                ))}
              </div>
              <ul class="mix-legend pixel">
                {q.languages.map((l) => (
                  <li>
                    <span class="dot" style={`--c:${l.color}`} aria-hidden="true" />
                    {l.name} <span>{Math.round(l.pct)}%</span>
                  </li>
                ))}
              </ul>
              <dl class="loot-stats">
                <div>
                  <dt class="pixel">Commits</dt>
                  <dd class="pixel">{q.commits}</dd>
                </div>
                <div>
                  <dt class="pixel">Started</dt>
                  <dd class="pixel">{new Date(q.createdAt).toLocaleDateString('en-US', { month: 'short', year: 'numeric', timeZone: 'UTC' })}</dd>
                </div>
                <div>
                  <dt class="pixel">Last push</dt>
                  <dd class="pixel" data-ago={q.pushedAt}>{ago(q.pushedAt)}</dd>
                </div>
              </dl>
            </div>

            <div class="quest-body">
              <div class="quest-meta pixel">
                <span class={`status status-${q.status.tone}`}>
                  <span class="status-dot" aria-hidden="true" />
                  {q.status.label}
                </span>
                {q.live && <span>Live demo available</span>}
              </div>

              <h3 class="quest-title">{q.title}</h3>
              <p class="quest-hook">{q.hook}</p>
              {q.flavor && <blockquote class="flavor">{q.flavor}</blockquote>}

              <dl class="brief">
                {q.problem && (
                  <div>
                    <dt class="pixel">Objective</dt>
                    <dd>{q.problem}</dd>
                  </div>
                )}
                {q.approach && (
                  <div>
                    <dt class="pixel">Strategy</dt>
                    <dd>{q.approach}</dd>
                  </div>
                )}
                {q.outcome && (
                  <div>
                    <dt class="pixel">Reward</dt>
                    <dd>{q.outcome}</dd>
                  </div>
                )}
              </dl>

              <div class="quest-foot">
                <ul class="chips" aria-label="Built with">
                  {q.stack.map((s: string) => (
                    <li class="chip">{s}</li>
                  ))}
                </ul>
                <div class="actions">
                  {q.live && (
                    <a class="btn btn-primary" href={q.live} target="_blank" rel="noopener">
                      ▶ Play live
                    </a>
                  )}
                  <a class="btn" href={q.source} target="_blank" rel="noopener">
                    Source
                  </a>
                </div>
              </div>
            </div>
          </li>
        ))
      }
    </ol>

    {
      sideQuests.length > 0 && (
        <>
          <h3 class="side-heading pixel reveal">
            <span>Side Quests</span>
            <small>Smaller ML builds</small>
          </h3>
          <ul class="side-list">
            {sideQuests.map((q) => (
              <li class="side win reveal">
                <div class="side-top pixel">
                  <span class="dot" style={`--c:${q.language?.color ?? '#8b8fb0'}`} aria-hidden="true" />
                  <span>{q.language?.name === 'Jupyter Notebook' ? 'Python' : q.language?.name}</span>
                  <span class="side-age" data-ago={q.pushedAt}>
                    {ago(q.pushedAt)}
                  </span>
                </div>
                <h4>{q.title}</h4>
                <p>{q.hook}</p>
                <ul class="chips">
                  {q.stack.map((s: string) => (
                    <li class="chip">{s}</li>
                  ))}
                </ul>
                <div class="actions">
                  {q.live && (
                    <a class="btn btn-primary" href={q.live} target="_blank" rel="noopener">
                      ▶ Try it
                    </a>
                  )}
                  <a class="btn" href={q.source} target="_blank" rel="noopener">
                    Source
                  </a>
                </div>
                {q.liveNote && <p class="live-note">{q.liveNote}</p>}
              </li>
            ))}
          </ul>
        </>
      )
    }
  </div>
</section>

<style>
  .quest-list {
    display: grid;
    gap: clamp(36px, 5vw, 56px);
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .quest {
    display: grid;
    grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr);
    grid-template-rows: auto 1fr;
    grid-template-areas:
      'art body'
      'loot body';
    gap: 24px clamp(20px, 3vw, 36px);
    padding: clamp(16px, 2.4vw, 26px);
  }

  .quest:nth-child(even) {
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    grid-template-areas:
      'body art'
      'body loot';
  }

  .quest-art {
    grid-area: art;
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: #050414;
    border: 2px solid rgba(239, 230, 207, 0.45);
    border-radius: 4px;
    box-shadow: inset 0 0 0 2px var(--frame-dark);
  }

  .quest-art img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: top left;
    transition: transform 0.6s ease;
  }

  .quest:hover .quest-art img {
    transform: scale(1.03);
  }

  /* A soft scanline sheen so screenshots sit inside the world. */
  .quest-art::after {
    content: '';
    position: absolute;
    inset: 0;
    pointer-events: none;
    background:
      repeating-linear-gradient(0deg, rgba(3, 2, 13, 0.12) 0 1px, transparent 1px 3px),
      linear-gradient(180deg, transparent 60%, rgba(17, 12, 54, 0.6));
  }

  .emblem {
    display: grid;
    place-items: center;
    width: 100%;
    height: 100%;
    background:
      radial-gradient(circle at 50% 45%, color-mix(in srgb, var(--lang) 45%, transparent), transparent 55%),
      conic-gradient(from 45deg, #120d38, #1d1556, #120d38, #1d1556, #120d38),
      #120d38;
  }

  .emblem span {
    position: relative;
    isolation: isolate;
    display: grid;
    place-items: center;
    width: 34%;
    aspect-ratio: 1;
    font-size: clamp(2rem, 5vw, 3.4rem);
    color: var(--gold);
    text-shadow: 0 3px 0 var(--frame-dark);
  }

  .emblem span::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: rgba(3, 2, 13, 0.6);
    border: 3px solid var(--frame);
    box-shadow:
      0 0 0 3px var(--frame-dark),
      0 0 50px color-mix(in srgb, var(--lang) 55%, transparent);
    transform: rotate(45deg);
  }

  .quest-no {
    position: absolute;
    left: 10px;
    top: 10px;
    z-index: 1;
    padding: 0.1em 0.55em;
    font-size: 0.8rem;
    color: var(--frame-dark);
    background: var(--gold);
    border-radius: 2px;
    box-shadow: 0 0 0 2px var(--frame-dark);
  }

  .loot {
    grid-area: loot;
    align-self: start;
    padding: 14px 16px 16px;
    background: rgba(3, 2, 13, 0.32);
    border: 1px solid rgba(239, 230, 207, 0.14);
    border-radius: 4px;
  }

  .loot-head {
    margin-bottom: 0.55rem;
    font-size: 0.75rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .mix {
    display: flex;
    gap: 2px;
    height: 12px;
    padding: 2px;
    background: var(--frame-dark);
    box-shadow: 0 0 0 1px rgba(239, 230, 207, 0.3);
  }

  .mix span {
    flex-basis: 0;
    min-width: 3px;
    background: var(--c);
  }

  .mix-legend {
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1rem;
    margin: 0.6rem 0 0;
    padding: 0;
    list-style: none;
    font-size: 0.78rem;
    color: var(--ink-dim);
  }

  .mix-legend li {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }

  .mix-legend li span:last-child {
    color: var(--ink-faint);
  }

  .loot-stats {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 0.5rem;
    margin: 0.9rem 0 0;
    padding-top: 0.8rem;
    border-top: 1px dashed rgba(239, 230, 207, 0.14);
  }

  .loot-stats dt {
    font-size: 0.7rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .loot-stats dd {
    margin: 0.1rem 0 0;
    font-size: 1.15rem;
    color: #fff6dc;
  }

  .quest-body {
    grid-area: body;
    display: flex;
    flex-direction: column;
    min-width: 0;
  }

  .quest-meta {
    display: flex;
    flex-wrap: wrap;
    gap: 0.35rem 1rem;
    font-size: 0.78rem;
    color: var(--ink-faint);
  }

  .status {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .status-dot {
    width: 7px;
    height: 7px;
    background: currentColor;
  }

  .status-live {
    color: var(--hp);
  }

  .status-live .status-dot {
    box-shadow: 0 0 8px var(--hp);
    animation: pulse 2s steps(2) infinite;
  }

  .status-ok {
    color: var(--mana);
  }

  @keyframes pulse {
    50% {
      opacity: 0.35;
    }
  }

  .quest-title {
    margin-top: 0.5rem;
    font-size: clamp(1.8rem, 3.6vw, 2.5rem);
    color: #fff6dc;
    text-shadow: 0 3px 0 var(--frame-dark);
  }

  .quest-hook {
    margin-top: 0.35rem;
    font-size: 1.08rem;
    font-weight: 500;
    color: var(--ink);
  }

  .flavor {
    margin: 0.9rem 0 0;
    padding: 0.15rem 0 0.15rem 0.9rem;
    font-style: italic;
    font-size: 0.95rem;
    color: var(--ink-dim);
    border-left: 3px solid var(--gold);
  }

  .brief {
    display: grid;
    gap: 0.85rem;
    margin: 1.1rem 0 0;
  }

  .brief dt {
    font-size: 0.78rem;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--gold);
  }

  .brief dt::before {
    content: '◆ ';
    color: var(--mana);
  }

  .brief dd {
    margin: 0.15rem 0 0;
    font-size: 0.96rem;
    line-height: 1.58;
    color: var(--ink-dim);
  }

  .quest-foot {
    display: grid;
    gap: 1rem;
    margin-top: auto;
    padding-top: 1.25rem;
  }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }

  .side-heading {
    display: flex;
    align-items: baseline;
    gap: 0.9rem;
    margin: clamp(56px, 7vw, 80px) 0 1.4rem;
    font-size: 1.6rem;
  }

  .side-heading small {
    font-family: var(--body);
    font-size: 0.95rem;
    color: var(--ink-faint);
  }

  .side-heading::after {
    content: '';
    flex: 1;
    height: 2px;
    background: linear-gradient(90deg, var(--ink-faint), transparent);
    opacity: 0.5;
  }

  .side-list {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 300px), 1fr));
    gap: 24px;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .side {
    display: flex;
    flex-direction: column;
    gap: 0.6rem;
  }

  .side-top {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.78rem;
    color: var(--ink-faint);
  }

  .side-age {
    margin-left: auto;
  }

  .side h4 {
    font-size: 1.3rem;
  }

  .side p {
    font-size: 0.95rem;
    color: var(--ink-dim);
    flex: 1;
  }

  .side .live-note {
    flex: none;
    font-size: 0.78rem;
    color: var(--ink-faint);
  }

  @media (max-width: 860px) {
    .quest,
    .quest:nth-child(even) {
      grid-template-columns: minmax(0, 1fr);
      grid-template-rows: none;
      grid-template-areas: 'art' 'body' 'loot';
    }
  }
</style>
